<?xml version="1.0" encoding="UTF-8"?>
<!-- Solo UDP, sin memoria compartida. El contenedor corre como root y sus segmentos de
     /dev/shm quedan rw-r--r-- de root: los procesos del host (rqt, rviz) no pueden abrirlos y
     no reciben nada del detector aunque vean los topics. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profile">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_only</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="udp_only_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_only</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
