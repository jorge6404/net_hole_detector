<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>net_hole_detector_rust</name>
  <version>0.1.0</version>
  <description>Port a Rust (r2r) de net_hole_detector: agujeros rotos en redes con YOLO-World (ONNX) y escala por las celdas de la red</description>
  <maintainer email="jorgee6404@gmail.com">Jorge Castro</maintainer>
  <license>BSD-4-Clause</license>
  <author>Jorge Castro</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rcl</depend>
  <depend>rcl_action</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <depend>net_hole_detector_msgs_rust</depend>
  <depend>libopencv-dev</depend>
  <!-- bindgen (r2r) y el crate opencv necesitan libclang para generar los bindings -->
  <build_depend>libclang-dev</build_depend>
  <!-- ONNX Runtime no es una clave de rosdep: se carga en ejecución desde
       ORT_DYLIB_PATH, $ONNXRUNTIME_ROOT/lib o /opt/onnxruntime/lib -->

  <exec_depend>launch_ros</exec_depend>

  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>python3-opencv</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
